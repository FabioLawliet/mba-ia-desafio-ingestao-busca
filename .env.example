# Provedor de IA: google | ollama
AI_PROVIDER=ollama

# Ollama local (AI_PROVIDER=ollama)
# Requer o Ollama instalado (https://ollama.com) e os modelos baixados:
#   ollama pull qwen3-embedding:0.6b
#   ollama pull gemma3:4b
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
OLLAMA_CHAT_MODEL=gemma3:4b

# Google AI Studio (AI_PROVIDER=google) ---
GOOGLE_API_KEY=informe-sua-api-key
GOOGLE_EMBEDDING_MODEL=models/gemini-embedding-001
GOOGLE_CHAT_MODEL=gemini-3.5-flash-lite

# Banco de dados 
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/rag
PG_VECTOR_COLLECTION_NAME=documentos_pdf
